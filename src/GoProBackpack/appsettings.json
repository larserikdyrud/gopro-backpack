{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Backpack": {
    "SerialPort": "/dev/ttyAMA0",
    "BaudRate": 115200,
    "RecChannel": 6,
    "MarkChannel": 7,
    "OnThreshold": 1400,
    "OffThreshold": 600,
    "LinkTimeout": "00:00:00.500",
    "LinkStableTime": "00:00:02",
    "StopHoldTime": "00:00:01",
    "StartRetryInterval": "00:00:02",
    "StopRetryInterval": "00:00:01",
    "MaxStopAttempts": 3,
    "CameraPollInterval": "00:00:00.500",
    "CameraOnlineTimeout": "00:00:02",
    "HttpTimeout": "00:00:01",
    "KeepAliveInterval": "00:00:03",
    "CameraSerial": null
  }
}
